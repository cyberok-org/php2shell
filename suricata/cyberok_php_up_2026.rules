# Suricata/Snort3-compatible rules — PHP-UP-2026 wave
# CVE-2026-109618 (OOM corruption via bailout) + CVE-2026-109619 (stale global state,
# session upload-progress consumer). Local SID space 1000006100-1000006199.
#
# Detection philosophy: the advisories' trigger surfaces are REQUEST SHAPES
# (chunked multipart, part-header amplification, name/filename flooding) and
# the upload-progress poisoning signatures (serialized objects / PHP open tags
# in PHP_SESSION_UPLOAD_PROGRESS value or in a multipart filename). All rules
# are alert-only by default — tune to drop after measuring your baselines.

# --- CVE-2026-109618, vector A: multipart without a usable Content-Length -----
# PHP's post_max_size check needs Content-Length; a chunked multipart POST
# bypasses it while feeding the parser (advisory-confirmed vector).
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 CVE-2026-109618 chunked multipart POST (post_max_size bypass surface)"; flow:established,to_server; http.method; content:"POST"; http.header; content:"Content-Type|3a| multipart/form-data"; nocase; content:"Transfer-Encoding|3a| chunked"; nocase; content:!"Content-Length|3a|"; classtype:attempted-dos; sid:1000006101; rev:2; metadata:created_at 2026_10_21, cve CVE-2026-109618;)

# --- CVE-2026-109618, vector B: part-header amplification ---------------------
# A single multipart part carrying an abnormal number of headers: in-memory
# representation far exceeds wire size, exhausting memory_limit inside
# post_max_size (validated shape: 150k X-Pad headers).
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 CVE-2026-109618 multipart part-header amplification (100+)"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/(\r\nX-[A-Za-z][A-Za-z0-9-]{0,31}\x3a[^\r\n]{0,256}){100,}/"; classtype:attempted-dos; sid:1000006102; rev:1; metadata:created_at 2026_10_21, cve CVE-2026-109618;)
# generic variant: any part-header run of 100+ lines (not just X-*)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 CVE-2026-109618 multipart header-run amplification (generic)"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/(\r\n[A-Za-z][A-Za-z0-9-]{1,32}\x3a[^\r\n]{1,256}){200,}/"; classtype:attempted-dos; sid:1000006103; rev:1; metadata:created_at 2026_10_21, cve CVE-2026-109618;)

# --- CVE-2026-109618, auxiliary shapes (upstream regression corpus) -----------
# deeply nested variable names (a[][b][b]... 40+ levels)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 CVE-2026-109618 deeply nested multipart/urlencoded names (40+)"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/(name=\"[^\"]{0,64}(\[[^\]]{0,32}\]){40,}|[a-z][a-z0-9_]{0,32}(\[[^\]]{0,32}\]){40,}=)/"; classtype:attempted-dos; sid:1000006104; rev:2; metadata:created_at 2026_10_21, cve CVE-2026-109618;)
# empty-file control flood (bypasses max_file_uploads accounting)
# Suricata note: occurrence-COUNTING over variable-gap multipart units is
# unreliable here (PCRE2 rejects the span; inspect windows split it) — this rule
# fires on the unit signature; robust {50,} counting is done by the ModSecurity
# companion rule (1006104). Tune severity to WARNING if you see benign empty
# file controls (some multi-upload UIs send them one-by-one).
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 CVE-2026-109618 empty-filename file control (flood component, count in WAF)"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/filename=\"\"\x0d\x0aContent-Type/"; classtype:attempted-dos; sid:1000006105; rev:3; metadata:created_at 2026_10_21, cve CVE-2026-109618;)

# --- CVE-2026-109619: upload-progress poisoning signatures --------------------
# serialized object / PHP open tag inside the PHP_SESSION_UPLOAD_PROGRESS value
# (session-file poisoning: the value becomes a $_SESSION key verbatim)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 CVE-2026-109619 serialized payload in PHP_SESSION_UPLOAD_PROGRESS (session poisoning)"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/name=\"PHP_SESSION_UPLOAD_PROGRESS\"\r\n\r\n[^\r\n]{0,1024}?(<\x3f\x3d|<\x3fphp|O\x3a\d{1,5}\x3a\"|a\x3a\d{1,6}\x3a\{|\|[a-z]{1,4}\x3a)/"; classtype:web-application-attack; sid:1000006106; rev:1; metadata:created_at 2026_10_21, cve CVE-2026-109619;)
# payload inside a multipart FILENAME (second carrier; the filename is stored
# verbatim in the progress structure)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 CVE-2026-109619 payload in multipart filename (upload-progress carrier)"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/filename=\"[^\"]{0,512}?(<\x3f\x3d|<\x3fphp|O\x3a\d{1,5}\x3a\")/"; classtype:web-application-attack; sid:1000006107; rev:1; metadata:created_at 2026_10_21, cve CVE-2026-109619;)
# session id injected as a multipart FORM FIELD (cookie-less sid control; never
# legitimate — session ids travel in cookies/URL, not form fields).
# Residual-surface note (verified 2026-10-21): form-SID ingestion SURVIVES the
# 8.2.35 fix (with cleanup=0 the progress still lands in the chosen sess_<sid>)
# — this rule stays relevant on PATCHED versions as the poisoning-enabler
# signal (pairs with 1000006106/6107). Sid traversal NOT reachable here: the
# [A-Za-z0-9,-] charset validator rejects it on both versions.
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 PHPSESSID supplied as multipart form field (sid injection)"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"name=\"PHPSESSID\""; nocase; classtype:web-application-attack; sid:1000006108; rev:1; metadata:created_at 2026_10_21, cve CVE-2026-109619;)

# --- anomaly: consecutive Content-Disposition header lines ----------------------
# Detects 10+ immediately adjacent Content-Disposition headers (no body or
# boundary between them). This is a header-run anomaly, NOT a total part
# counter — real multipart has body+boundary between CD lines. For total
# part counting, use the ModSecurity &ARGS rule (1006115).
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 multipart consecutive Content-Disposition headers (10+, header-run anomaly)"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/(Content-Disposition\x3a form-data\x3b[^\r\n]{0,200}\r\n){10,}/"; classtype:attempted-dos; sid:1000006109; rev:1; metadata:created_at 2026_10_21, cve CVE-2026-109618;)

# --- handler-mismatch seed: pipe-prefixed serialized payload in progress value ---
# The exploit seeds "|O:4:\"Evil\":1:{...}" as the upload-progress value under
# php_serialize (stored verbatim as session key); the fire request decodes it
# under the php handler, splitting at "|" and running __destruct().
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 handler-mismatch seed: pipe+serialized in PHP_SESSION_UPLOAD_PROGRESS"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/name=\"PHP_SESSION_UPLOAD_PROGRESS\"\r\n\r\n\|[a-zA-Z]/"; classtype:web-application-attack; sid:1000006110; rev:1; metadata:created_at 2026_10_21, cve CVE-2026-109619;)

# --- response-side leak oracle: oversized/binary PHPSESSID cookie ---
# The remote CVE chain leaks heap pointers (Zend MM chunk base, libphp base)
# through Set-Cookie: PHPSESSID=<binary garbage>. A legitimate PHPSESSID is
# 26-64 chars from [A-Za-z0-9,-]; >200 bytes or non-conforming bytes = leak.
alert http $HOME_NET $HTTP_PORTS -> $EXTERNAL_NET any (msg:"PHP-UP-2026 CVE-2026-109618 Set-Cookie PHPSESSID leak oracle (oversized/binary)"; flow:established,to_client; http.response_header; content:"PHPSESSID="; pcre:"/Set-Cookie\x3a PHPSESSID=[^\r\n]{200,}/"; classtype:attempted-admin; sid:1000006111; rev:1; metadata:created_at 2026_10_21, cve CVE-2026-109618;)

# --- 109618 arm: giant multipart filename (>64KB) ---
# The arm stage sends filenames of 262,144 bytes to exhaust memory during
# request parsing. Legitimate filenames rarely exceed 255 bytes; >4000 chars
# is anomalous. (Threshold kept at 4000 to fit the ~4KB inspect window.)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 CVE-2026-109618 giant multipart filename (>64KB, heap exhaustion arm)"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/filename=\"[^\r\n]{4000,}/"; classtype:attempted-dos; sid:1000006112; rev:1; metadata:created_at 2026_10_21, cve CVE-2026-109618;)

# --- generic anomaly: PHP_SESSION_UPLOAD_PROGRESS field present at all -------
# The upload-progress mechanism is PHP-internal; applications rarely expose
# it in legitimate forms. Any request carrying this field is at minimum
# anomalous, at worst part of an attack chain (poisoning/leak/ASLR bypass).
# Low severity — tune to your application's baseline.
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 anomaly: PHP_SESSION_UPLOAD_PROGRESS field present in request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; nocase; classtype:web-application-activity; sid:1000006113; rev:1; metadata:created_at 2026_10_22, cve CVE-2026-109618;)

# --- invalid PHPSESSID value in Cookie header --------------------------------
# PHP session IDs use [a-zA-Z0-9,-] charset (default: 32 hex chars).
# Values containing other characters (underscore, null, binary, etc.) are
# crafted probes — the PortSwigger technique uses PHPSESSID=_ specifically.
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 invalid PHPSESSID cookie value (charset violation)"; flow:established,to_server; http.cookie; content:"PHPSESSID="; pcre:"/(?:^|\x3b)\s*PHPSESSID=[^\s\x3b]*[^a-zA-Z0-9,\-\s\x3b]/"; classtype:web-application-attack; sid:1000006114; rev:2; metadata:created_at 2026_10_22, cve CVE-2026-109618;)

# --- LFI trigger: session-file path in URI (ikow 2026106 + rafalohaki paths) ---
# Every poisoning chain needs an application-level include/LFI that accepts
# the session-file path. Common save_paths: /tmp, /var/lib/php/sessions,
# /var/www/sess, /tmp/sess. Param names: tpl, template, view, page, file.
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 session-file path in URI (LFI trigger for poisoning chain)"; flow:established,to_server; http.uri; pcre:"/(?:\/(?:tmp|var\/lib\/php|var\/www)\/(?:sessions?\/|sess\/)?|\/tmp\/)sess_[A-Za-z0-9,-]{6,}/i"; classtype:web-application-attack; sid:1000006115; rev:1; metadata:created_at 2026_10_22;)

# --- response-side: OOM success indicator (ikow 2026110) ---
# "Allowed memory size of X bytes exhausted" in the response body — evidence
# that the OOM arm reached PHP's request parser during startup.
alert http $HOME_NET $HTTP_PORTS -> $EXTERNAL_NET any (msg:"PHP-UP-2026 CVE-2026-109618 OOM in response (memory exhausted during request parsing)"; flow:established,to_client; http.response_body; content:"Allowed memory size"; content:"exhausted"; distance:0; within:64; classtype:attempted-dos; sid:1000006116; rev:1; metadata:created_at 2026_10_22, cve CVE-2026-109618;)

# --- response-side: session object destruction failed (ikow 2026111) ---
# Direct evidence of CVE-2026-109619 stale-state consumption — the session
# decode in the pre-RINIT path encountered corrupted/unreadable data.
alert http $HOME_NET $HTTP_PORTS -> $EXTERNAL_NET any (msg:"PHP-UP-2026 CVE-2026-109619 session destruction failure in response (stale state consumed)"; flow:established,to_client; http.response_body; content:"Session object destruction failed"; classtype:attempted-admin; sid:1000006117; rev:1; metadata:created_at 2026_10_22, cve CVE-2026-109619;)

# --- response-side: failed to decode session object (sibling of 6117) ---
alert http $HOME_NET $HTTP_PORTS -> $EXTERNAL_NET any (msg:"PHP-UP-2026 CVE-2026-109619 failed session decode in response"; flow:established,to_client; http.response_body; content:"Failed to decode session object"; classtype:attempted-admin; sid:1000006118; rev:1; metadata:created_at 2026_10_22, cve CVE-2026-109619;)

# --- post-exploit IoCs (rafalohaki) ---
# Default webshell names and response markers from the 8512 chain
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 post-exploit IoC: php2shell webshell access"; flow:established,to_server; http.uri; content:"p2s_8512_shell.php"; classtype:successful-admin; sid:1000006119; rev:1; metadata:created_at 2026_10_22;)
alert http $HOME_NET $HTTP_PORTS -> $EXTERNAL_NET any (msg:"PHP-UP-2026 post-exploit IoC: SHELL_ALIVE marker in response"; flow:established,to_client; http.response_body; content:"SHELL_ALIVE"; classtype:successful-admin; sid:1000006120; rev:1; metadata:created_at 2026_10_22;)

# --- Corelight-derived: serialized integer-key collision pattern ------------
# Detects the 2^32-step integer sequence (4294967296, 8589934592, 12884901888)
# used by the ASLR-bypass heap spray. Structural signature that doesn't depend
# on PHP_SESSION_UPLOAD_PROGRESS presence or specific class names.
# Credit: Corelight SID 3000653 (adapted to our SID space)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 serialized integer-key collision pattern (heap spray, ASLR bypass)"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"i:4294967296|3b|"; fast_pattern; content:"i:8589934592|3b|"; distance:0; within:48; content:"i:12884901888|3b|"; distance:0; within:48; classtype:attempted-admin; sid:1000006121; rev:1; metadata:created_at 2026_10_28, cve CVE-2026-109618, cve CVE-2026-109619;)

# =========================================================================
# WAVE 2 — 2026-11-19 security release (8.2.36 / 8.3.37 / 8.4.28 / 8.5.13)
# CVE-2026-129289 (FPM request smuggling), CVE-2026-129538 (CGI PATH_INFO
# underflow — the CVE-assigned form of CyberOK's October N1 finding),
# CVE-2026-127960 (quadratic folded-header client DoS). SIDs 1000006130+.
# =========================================================================

# --- CVE-2026-129289: FastCGI record smuggled in an unread request body ------
# If the app opens php://input without consuming it, request shutdown left
# the FastCGI STDIN un-drained; with FCGI_KEEP_CONN (nginx fastcgi_keep_conn on)
# the leftover body bytes were parsed as the next FastCGI record stream
# (fix: "Drain unread request bodies"). CyberOK e2e (2026-11-19): the smuggled
# BEGIN_REQUEST is EMBEDDED at an offset inside a larger multipart body (not at
# offset 0), so the needle is id-agnostic and offset-agnostic: FCGI header
# 01 01 <any id> 00 08 00 00 followed by role 00 01 (RESPONDER). Lab-validated
# against real smuggled execution traffic on PHP-FPM 8.2.35 behind nginx.
# rev:3 (review 2026-11-19): any method (PUT/PATCH + a single fread(php://input)
# also carry the record), any non-zero version byte (FPM accepts version>=1) and
# any padding/reserved byte (evasive framing); type=1, clen=8, role=RESPONDER.
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 W2 CVE-2026-129289 FastCGI BEGIN_REQUEST record embedded in HTTP request body (FPM smuggling)"; flow:established,to_server; http.request_body; content:"|00 08|"; content:"|00 01|"; distance:2; within:2; pcre:"/[\x01-\xff]\x01[\x00-\xff]{2}\x00\x08[\x00-\xff]{2}\x00\x01/s"; classtype:attempted-admin; sid:1000006130; rev:3; metadata:created_at 2026_11_19, cve CVE-2026-129289;)

# --- CVE-2026-129538: CGI PATH_INFO underflow recon --------------------------
# php-cgi with cgi.fix_pathinfo=1 re-derived PATH_INFO by subtracting the
# suffix stripped from SCRIPT_FILENAME/PATH_TRANSLATED; a suffix LONGER than
# PATH_INFO underflowed the pointer and echoed adjacent environment memory
# (CyberOK-observed leak fragment: "US=1" out of REDIRECT_STATUS=1). Wire
# shape of the probe: a .php script followed by an abnormally long suffix
# segment. 512+ chars is well above framework-routing tails (CI-style
# /index.php/<route> stays < 200); tune DOWN for recon-hungry deployments.
# rev:2 (review 2026-11-19): count every byte up to "?"/"#", including "/": a
# suffix split into /AAAA.../AAAA... segments underflows just as well and evaded
# the old [A-Za-z0-9_~%.-]{512,} class (0 hits on a 7 KB, 34-slash probe).
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 W2 CVE-2026-129538 CGI PATH_INFO underflow probe (.php URI with 512+ char suffix)"; flow:established,to_server; http.uri; content:".php/"; fast_pattern; pcre:"/\.php\/[^?#]{512}/"; classtype:attempted-recon; sid:1000006131; rev:2; metadata:created_at 2026_11_19, cve CVE-2026-129538;)

# --- CVE-2026-129538, vector B: newline in the URI suffix ---------------------
# CyberOK e2e finding (2026-11-19): a %0A inside the suffix defeats nginx's
# `fastcgi_split_path_info` regex (dot does not match newline — the
# CVE-2019-11043 technique). In a split location WITHOUT a try_files/file-
# existence check nginx falls back to passing the full URI and the underflow
# triggers there too (with try_files $fastcgi_script_name =404 the lab stayed
# clean) — not only on no-split configs (lab-confirmed:
# /reflect.php/SH%0aORT -> PATH_INFO echo of adjacent param-storage memory on
# stock php-cgi 8.3.6; patched 8.2.36 returns empty PATH_INFO). Short suffixes
# suffice, so the 512+ rule above does NOT cover this vector.
# Buffer note: http.uri is the NORMALIZED (percent-decoded) URI — the newline
# arrives as a raw \x0a byte there, not as "%0a" (lab-verified on Suricata 7).
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"PHP-UP-2026 W2 CVE-2026-129538 CGI PATH_INFO underflow via newline in .php URI suffix (split-config bypass)"; flow:established,to_server; http.uri; pcre:"/\.php\/[^\x0a\x0d]{0,64}[\x0a\x0d]/"; classtype:attempted-recon; sid:1000006133; rev:2; metadata:created_at 2026_11_19, cve CVE-2026-129538;)

# --- CVE-2026-127960: obs-fold continuation run in response headers ----------
# PHP acting as an HTTP CLIENT (http:// wrapper, file_get_contents, etc.)
# parsed folded response headers quadratically — a malicious server could
# stall the client with a few MB of " SP"-continuation lines (fix: linear
# smart_str accumulation). Fires on the RESPONSE side of outbound fetches.
# Buffer note (Suricata 7): http.response_header normalises/unfolds
# continuation lines, and http.response_header_raw does NOT exist in 7.0.x —
# so the fold signature is matched on the RAW STREAM as a dense cluster:
# five CRLF+SP occurrences each within 48 bytes of the previous (CyberOK
# lab-validated on real fold-attack traffic; single CRLF-SP matches occur in
# benign bodies, a 5x dense cluster does not — tune count/window per baseline).
alert tcp $EXTERNAL_NET $HTTP_PORTS -> $HOME_NET any (msg:"PHP-UP-2026 W2 CVE-2026-127960 dense obs-fold continuation cluster in HTTP response (PHP client DoS)"; flow:established,to_client; content:"|0d 0a 20|"; content:"|0d 0a 20|"; distance:0; within:48; content:"|0d 0a 20|"; distance:0; within:48; content:"|0d 0a 20|"; distance:0; within:48; content:"|0d 0a 20|"; distance:0; within:48; classtype:attempted-dos; sid:1000006132; rev:2; metadata:created_at 2026_11_19, cve CVE-2026-127960;)
